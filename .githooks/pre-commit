#!/usr/bin/env bash
# Pre-commit hook: catch unresolvable Documenter @ref cross-references before
# they reach CI, where they abort the ~2.5 h docs build at the very last step.
#
# Runs a draft-mode docs build (`docs/make.jl draft`: no @example execution,
# a few minutes, mostly package loading) — but only when the staged changes
# could plausibly affect cross-references: anything under docs/, or a .jl
# diff that touches a docstring or an @ref link.
#
# Enable in your clone with:  git config core.hooksPath .githooks
# Skip one commit with:       git commit --no-verify
# Or set:                     OCTOFITTER_SKIP_DOCS_CHECK=1

set -u

[ "${OCTOFITTER_SKIP_DOCS_CHECK:-0}" = "1" ] && exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

if echo "$staged" | grep -qE '^docs/'; then
    :
elif git diff --cached -- '*.jl' | grep -qE '^[+-].*(@ref|""")'; then
    :
else
    exit 0
fi

if [ ! -f docs/Manifest.toml ]; then
    echo "pre-commit: docs/Manifest.toml missing — skipping docs cross-reference check."
    echo "pre-commit: to enable it, instantiate the docs env (dev the local packages"
    echo "pre-commit: as in .github/workflows/docs.yml, then Pkg.instantiate())."
    exit 0
fi

echo "pre-commit: staged changes may affect docs cross-references."
echo "pre-commit: running draft docs build (~3-10 min; skip with --no-verify)..."

# Note: this builds the working tree, not the index — with unstaged docs
# edits present, the result can differ from the commit being checked.
if ! julia --project=docs --color=yes docs/make.jl draft; then
    echo
    echo "pre-commit: draft docs build FAILED — likely an unresolved @ref."
    echo "pre-commit: fix the cross-reference, or bypass with 'git commit --no-verify'."
    exit 1
fi
